# ============================================================
# Barbershop Bot - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ----- REQUIRED -----

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Comma-separated list of admin Telegram IDs (get via @userinfobot)
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# ----- DATABASE (choose one) -----

# Option A: SQLite (default, no setup needed)
# Leave DATABASE_URL empty to use SQLite at DB_PATH
DB_PATH=/app/data/barbershop.db

# Option B: PostgreSQL (recommended for production / Railway)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ----- OPTIONAL -----

# Timezone (IANA format)
TIMEZONE=Asia/Almaty

# Redis for FSM storage (recommended for multi-instance / Railway)
# REDIS_URL=redis://:password@host:6379/0
REDIS_URL=

# Master Telegram IDs (to notify masters about bookings)
# Format: MasterName1=telegram_id1,MasterName2=telegram_id2
# Example: MASTER_IDS=Алибек=111111111,Дамир=222222222
MASTER_IDS=

# Minimum minutes in advance a booking can be made (default: 60)
MIN_BOOKING_ADVANCE_MINUTES=60

# Proxy URL (if Telegram is blocked in your country)
# PROXY_URL=http://proxy.example.com:8080
PROXY_URL=

# ----- OFF-SITE BACKUP (HIGH-1 FIX) -----
# Uploads the daily DB backup to any S3-compatible store (AWS S3, Cloudflare R2,
# Backblaze B2, MinIO, ...). Leave ALL of these empty to disable off-site backup
# (the local /app/backups copy is always kept). Off-site upload is SKIPPED unless
# S3_BUCKET, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY are all set.
# Credentials are read from env only — never hardcoded, never logged.

# S3_ENDPOINT_URL is REQUIRED for R2/B2/MinIO, and OPTIONAL for AWS S3.
#   AWS S3:        leave empty (uses the default regional endpoint)
#   Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
#   Backblaze B2:  https://s3.<region>.backblazeb2.com
# S3_ENDPOINT_URL=

# Region (optional for R2/B2; recommended for AWS S3).
# S3_REGION=

# Target bucket name (required to enable off-site backup).
# S3_BUCKET=

# Key prefix / "folder" inside the bucket (optional). Example: prod
# S3_PREFIX=

# Credentials (required to enable off-site backup). Use a scoped, least-privilege key.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# How many newest off-site backups to keep (default 30). Older ones are pruned.
# S3_BACKUP_RETENTION=30

