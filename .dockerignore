# .dockerignore — keep the build context minimal.
# Excluded from `docker build` (and therefore absent from the runtime image).

# Python bytecode + caches
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Local persistence — Railway uses mounted volumes, not COPY
data/
backups/
logs/
*.db
*.db.gz
*.sql.gz
fsm_state.json
fsm_state.json.bak

# Tests + dev artifacts (CI runs them, runtime doesn't need them)
tests/
.venv*/
.venv-test/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.test.py
write_tests.py
write_admin5.py
patch_fixes.py
storage_sqlite_backup.py
migrate_db.py
storage_sqlite_backup.pyc
migrate_db.pyc

# Env + secrets
.env
.env.*
!.env.example

# CI / IDE
.github/
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docs (large and not needed at runtime)
README.md
CHANGELOG.md
OPERATIONS.md
DEPLOYMENT.md
LICENSE

# WorkBuddy internal cache (not source code)
.workbuddy-ai/

# EditorConfig / pre-commit / Makefile / pyproject — keep in tree for IDEs
# but exclude from image to save ~30 KB; not strictly required.
Makefile
.editorconfig
.pre-commit-config.yaml
